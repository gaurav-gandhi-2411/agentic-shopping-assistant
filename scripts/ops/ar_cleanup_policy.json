[
  {
    "name": "delete-old-versions",
    "action": {"type": "Delete"},
    "condition": {"tagState": "any", "olderThan": "1d"}
  },
  {
    "name": "keep-newest-2",
    "action": {"type": "Keep"},
    "mostRecentVersions": {"keepCount": 2}
  },
  {
    "name": "keep-live-and-prev",
    "action": {"type": "Keep"},
    "condition": {"tagState": "tagged", "tagPrefixes": ["live", "prev"]}
  }
]
